+// This file is part of the occccad modification to Open CASCADE Technology.
+// SPDX-License-Identifier: LGPL-2.1-only WITH OCCT-exception-1.0
+#ifndef _BOPTools_FaceEdgeLookup_HeaderFile
+#define _BOPTools_FaceEdgeLookup_HeaderFile
+
+#include <NCollection_DataMap.hxx>
+#include <TopExp_Explorer.hxx>
+#include <TopoDS_Face.hxx>
+#include <TopTools_IndexedMapOfShape.hxx>
+
+// Operation-local lookup for the first occurrence of an edge in an oriented,
+// located face. An IsSame edge key must retain the first encountered orientation
+// even on a seam. The face key includes orientation because the explorer composes it.
+class BOPTools_FaceEdgeLookup
+{
+  static constexpr int THE_LINEAR_SEARCH_LIMIT = 32;
+
+public:
+  TopoDS_Shape Find(const TopoDS_Shape& theEdge, const TopoDS_Face& theFace)
+  {
+    const TopTools_IndexedMapOfShape* aMap = myFaces.Seek(theFace);
+    if (!aMap)
+    {
+      TopExp_Explorer anExp(theFace, TopAbs_EDGE);
+      for (int i = 0; anExp.More() && i < THE_LINEAR_SEARCH_LIMIT; anExp.Next(), ++i)
+      {
+        if (anExp.Current().IsSame(theEdge))
+          return anExp.Current();
+      }
+      if (!anExp.More())
+        return TopoDS_Shape();
+
+      TopTools_IndexedMapOfShape* aNew = myFaces.Bound(theFace, TopTools_IndexedMapOfShape());
+      for (anExp.Init(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+        aNew->Add(anExp.Current());
+      aMap = aNew;
+    }
+    const int anIndex = aMap->FindIndex(theEdge);
+    return anIndex ? aMap->FindKey(anIndex) : TopoDS_Shape();
+  }
+
+private:
+  NCollection_DataMap<TopoDS_Shape, TopTools_IndexedMapOfShape> myFaces;
+};
+#endif
