{
  "version": 9,
  "configurePresets": [
    {
      "name": "dev-release",
      "displayName": "Development Release (default)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/linux-gcc15-x86_64/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OCCCCAD_BUILD_TESTS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/linux-gcc15-x86_64/release/build/Release/generators/conan_toolchain.cmake",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/linux-gcc15-x86_64/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OCCCCAD_BUILD_TESTS": "ON",
        "OCCCCAD_ENABLE_ASAN": "OFF",
        "OCCCCAD_ENABLE_UBSAN": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/linux-gcc15-x86_64/debug/build/Debug/generators/conan_toolchain.cmake",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15"
      }
    },
    {
      "name": "dev-sanitize",
      "displayName": "Optional ASan + UBSan",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/cmake/linux-gcc15-x86_64/sanitize",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/linux-gcc15-x86_64/sanitize/build/Debug/generators/conan_toolchain.cmake",
        "OCCCCAD_ENABLE_ASAN": "ON",
        "OCCCCAD_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "jobs": 4
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "jobs": 4
    },
    {
      "name": "dev-sanitize",
      "configurePreset": "dev-sanitize",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "dev-sanitize",
      "configurePreset": "dev-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
