{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "occccad: Frontend (mock)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/apps/cad",
      "preLaunchTask": "frontend: mock"
    },
    {
      "name": "occccad: Frontend (API)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/apps/cad",
      "preLaunchTask": "frontend: api"
    },
    {
      "name": "occccad: API (routed debug)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/services/debug/occccad-server",
      "cwd": "${workspaceFolder}/services",
      "env": {
        "OCCCCAD_SERVER_LISTEN": "127.0.0.1:18081",
        "OCCCCAD_GEOMETRY_WORKER_ADDRESS": "127.0.0.1:51001",
        "OCCCCAD_DEV_PROFILE": "debug",
        "OCCCCAD_BUILD_TYPE": "Debug"
      },
      "preLaunchTask": "go: API debug and route",
      "postDebugTask": "control: debug API off"
    },
    {
      "name": "occccad: Jobs (exclusive debug)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/services/debug/occccad-jobs",
      "cwd": "${workspaceFolder}/services",
      "env": {
        "OCCCCAD_GEOMETRY_WORKER_ADDRESS": "127.0.0.1:51001",
        "OCCCCAD_DEV_PROFILE": "debug",
        "OCCCCAD_BUILD_TYPE": "Debug"
      },
      "preLaunchTask": "go: Jobs debug and route",
      "postDebugTask": "control: debug Jobs off"
    },
    {
      "name": "occccad: Geometry Worker (routed debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake/linux-gcc15-x86_64/debug/workers/geometry/occccad_geometry_worker",
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "OCCCCAD_GEOMETRY_WORKER_LISTEN",
          "value": "127.0.0.1:51999"
        }
      ],
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cpp: worker debug and route",
      "postDebugTask": "control: debug Geometry off"
    }
  ]
}
