{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: mock",
      "type": "shell",
      "command": "mise exec -- pnpm --dir web/apps/cad dev:mock --host 127.0.0.1 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "$^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*5173.*"
        }
      }
    },
    {
      "label": "frontend: api",
      "type": "shell",
      "command": "mise run web:dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "$^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*5173.*"
        }
      }
    },
    {
      "label": "control: debug API on",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "api",
        "--target",
        "127.0.0.1:18081"
      ]
    },
    {
      "label": "control: debug API off",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "api",
        "--off"
      ]
    },
    {
      "label": "control: debug Geometry on",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "geometry",
        "--target",
        "127.0.0.1:51999"
      ]
    },
    {
      "label": "control: debug Geometry off",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "geometry",
        "--off"
      ]
    },
    {
      "label": "control: debug Jobs on",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "jobs"
      ]
    },
    {
      "label": "control: debug Jobs off",
      "type": "process",
      "command": "mise",
      "problemMatcher": [],
      "args": [
        "run",
        "debug:route",
        "--service",
        "jobs",
        "--off"
      ]
    },
    {
      "label": "cpp: worker debug",
      "type": "process",
      "command": "mise",
      "args": [
        "run",
        "cpp:build",
        "--target",
        "occccad_geometry_worker",
        "--profile",
        "debug",
        "--jobs",
        "4"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "go: debug build",
      "type": "process",
      "command": "mise",
      "args": [
        "run",
        "go:build",
        "--profile",
        "debug",
        "--jobs",
        "4"
      ],
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "cpp: worker debug and route",
      "dependsOn": [
        "cpp: worker debug",
        "control: debug Geometry on"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "go: API debug and route",
      "dependsOn": [
        "go: debug build",
        "control: debug API on"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "go: Jobs debug and route",
      "dependsOn": [
        "go: debug build",
        "control: debug Jobs on"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
