      "scopes": [
        "tooling"
      ],
      "levels": [
        "unit"
      ]
    },
    {
      "id": "go-conformance-unit",
      "task": "go:conformance",
      "kind": "go",
      "scopes": [
        "services"
      ],
      "levels": [
