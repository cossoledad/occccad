        "occcad_assembly_solver_scenarios",
        "occcad_assembly_solver_corpus"
      ]
    },
    {
      "id": "assembly-native",
      "task": "cpp:test",
      "kind": "ctest",
      "scopes": [
        "assembly"
      ],
      "levels": [
        "unit"
      ],
      "resources": []
    },
    {
      "id": "geometry-build",
      "task": "cpp:build",
      "kind": "build",
      "scopes": [
        "geometry"
      ],
      "levels": [
        "unit"
      ],
      "targets": [
        "occcad_geometry_scenarios",
        "occccad_naming_artifact_tests"
      ]
    },
    {
      "id": "geometry-native",
      "task": "cpp:test",
