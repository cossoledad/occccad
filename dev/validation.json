        "geometry",
        "services"
      ],
      "levels": [
        "integration"
      ],
      "packages": [
        "./internal/control",
        "./internal/geometry"
      ],
      "resources": [
        "worker",
        "database",
        "artifact-store"
      ]
    },
    {
      "id": "services-integration",
      "task": "go:check",
      "kind": "go",
      "scopes": [
        "services"
      ],
      "levels": [
        "integration"
      ],
      "packages": [
        "./internal/api",
        "./internal/assistant",
        "./internal/automation",
        "./internal/database",
        "./internal/jobs",
        "./cmd/occccad-jobs",
        "./internal/artifact"
