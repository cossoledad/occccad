      "task": "go:check",
      "kind": "go",
      "scopes": [
        "workspace"
      ],
      "levels": [
        "unit"
      ],
      "packages": [
        "./internal/workspace",
        "./internal/modelcore"
      ],
      "resources": []
    },
    {
      "id": "services-unit",
      "task": "go:check",
      "kind": "go",
      "scopes": [
