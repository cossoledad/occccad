{
  "property": {
    "goal": "Add or change a writable domain property through its complete history lifecycle",
    "scopes": [
      "workspace"
    ],
    "sources": [
      [
        "services/internal/workspace/model_core.go",
        "PropertySlot"
      ],
      [
        "services/internal/workspace/history_core.go",
        "applyCompensatingHistory"
      ],
      [
        "services/internal/workspace/history_integration_test.go",
        "TestHistoryCapabilitiesAcrossTwoUndoAndRedoSteps"
      ]
    ],
    "documents": [
      "docs/architecture/current/model-history.md"
    ],
    "obligations": [
      "same stable slot in write/read/compensation",
      "canonical digest and dependency closure",
      "two Undo followed by two Redo",
      "final evaluated Revision owns the ChangeSet"
    ],
    "focused": "mise run check --scope workspace --match History",
    "complete": "mise run check --scope workspace",
    "escalate": "Public views require services/web; shared identity, migrations or protocol require all"
  },
