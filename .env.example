# occccad — Development configuration
#
# This repository does not manage infrastructure services.
# Configure database, artifacts, local processes and native builds here.
# Exported variables override this file; OCCCCAD_ENV_FILE selects another file.
# Values are literal KEY=VALUE entries, not shell expressions.
#
# Copy this file to .env and adjust for each environment:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database: PostgreSQL (default) or SQLite Local Mode
# OCCCCAD_DATABASE_URL overrides PostgreSQL fields below. SQLite requires an absolute local path.
# OCCCCAD_DATABASE_URL=sqlite:/absolute/path/occccad-local.db
OCCCCAD_DATABASE_URL=
# API and Jobs must share this file. OCCCCAD_DB_CONCURRENCY must be unset or 1 for SQLite.
# Reset commands clear the configured PostgreSQL schema or dedicated SQLite database and ArtifactStore.
# PostgreSQL uses the fixed occccad schema.
# OCCCCAD_DB_CONCURRENCY=1
# ---------------------------------------------------------------------------
OCCCCAD_POSTGRES_HOST=127.0.0.1
OCCCCAD_POSTGRES_PORT=5432
OCCCCAD_POSTGRES_USER=occccad
OCCCCAD_POSTGRES_PASSWORD=occccad
OCCCCAD_POSTGRES_DB=occccad

# ---------------------------------------------------------------------------
# 账号与会话。首次启动必须设置管理员密码；创建完成后数据库中的哈希不会被覆盖。
# 生产环境必须启用 HTTPS 并设置 OCCCCAD_SECURE_COOKIES=true。
# ---------------------------------------------------------------------------
OCCCCAD_ADMIN_EMAIL=admin@occccad.local
OCCCCAD_ADMIN_DISPLAY_NAME=Administrator
OCCCCAD_ADMIN_PASSWORD=change-this-before-first-start
OCCCCAD_SESSION_DURATION=12h
OCCCCAD_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# 制品存储。相对路径以 API/Jobs 服务的启动目录为基准。
# LOCAL 的持久制品目录；S3 下仅作为上传 spool 和几何计算暂存目录。
# 当前 API、Jobs 和本机 Geometry Worker 仍需访问同一计算暂存目录。
# invoke run.app --reset-data 会完整删除并重建这个目录；不要指向仓库或共享目录。
# ---------------------------------------------------------------------------
OCCCCAD_DATA_DIR=./data

# Artifact provider: LOCAL (default) or S3. Credentials stay in untracked .env.
OCCCCAD_ARTIFACT_BACKEND=LOCAL
OCCCCAD_S3_ENDPOINT=127.0.0.1:9000
OCCCCAD_S3_BUCKET=occccad
OCCCCAD_S3_REGION=us-east-1
OCCCCAD_S3_ACCESS_KEY=
OCCCCAD_S3_SECRET_KEY=
OCCCCAD_S3_SECURE=true
# Shared API/Worker file limit, bytes; default 16 GiB.
OCCCCAD_EXCHANGE_MAX_BYTES=17179869184

# Thumbnail SVG generation deadline. A fixed-size default is stored on timeout.
OCCCCAD_THUMBNAIL_RENDER_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Standalone API (invoke run.server)
# ---------------------------------------------------------------------------
OCCCCAD_SERVER_LISTEN=0.0.0.0:8080
# 通常由前端开发服务器或生产反向代理把 /api 转发到 API，无需 CORS。
# 如果浏览器直接跨域访问 API，则按逗号分隔列出允许的前端 Origin。
OCCCCAD_ALLOWED_ORIGINS=
# ---------------------------------------------------------------------------
# Standalone Geometry Worker (invoke run.worker)
# ---------------------------------------------------------------------------
OCCCCAD_GEOMETRY_WORKER_LISTEN=127.0.0.1:51001
OCCCCAD_GEOMETRY_WORKER_ADDRESS=127.0.0.1:51001

# ---------------------------------------------------------------------------
# Local application control plane
# invoke run.app only exposes APP_LISTEN. API and Geometry Router use stable
# internal addresses; managed worker instances start from FIRST_PORT.
# ---------------------------------------------------------------------------
OCCCCAD_APP_LISTEN=0.0.0.0:8080
OCCCCAD_CONTROL_LISTEN=127.0.0.1:19090
OCCCCAD_API_INTERNAL_LISTEN=127.0.0.1:18080
OCCCCAD_GEOMETRY_ROUTER_LISTEN=127.0.0.1:51001
OCCCCAD_GEOMETRY_WORKER_FIRST_PORT=51100
OCCCCAD_GEOMETRY_WORKER_MIN=1
OCCCCAD_GEOMETRY_WORKER_MAX=8
OCCCCAD_GEOMETRY_PER_WORKER=2
OCCCCAD_GEOMETRY_WORKER_IDLE=5m
# Optional executable overrides; otherwise use build/services and the selected native build.
# OCCCCAD_SERVER_BIN=/absolute/path/occccad-server
# OCCCCAD_JOBS_BIN=/absolute/path/occccad-jobs
# OCCCCAD_GEOMETRY_WORKER_BIN=/absolute/path/occccad_geometry_worker

# ---------------------------------------------------------------------------
# Native build (CLI --build-type overrides OCCCCAD_BUILD_TYPE)
# Release is the default; select Debug explicitly for native debugging.
# ---------------------------------------------------------------------------
OCCCCAD_BUILD_TYPE=Release
OCCCCAD_ENABLE_ASAN=OFF
OCCCCAD_ENABLE_UBSAN=OFF

# ---------------------------------------------------------------------------
# Observability
# OTLP endpoint 留空时仍生成 Trace ID 并写入日志/Command，但不导出 Span。
# ---------------------------------------------------------------------------
OCCCCAD_LOG_LEVEL=info
# C++ Geometry Worker 同时写控制台与滚动文件；相对路径由 control 以 services/ 为基准解析。
OCCCCAD_LOG_DIR=./logs
OTEL_EXPORTER_OTLP_ENDPOINT=

# Shared import work limit per Jobs process (positive integer; default 4).
# Actual per-file parallelism is min(component count, limit); Router total process
# count is separately bounded by OCCCCAD_GEOMETRY_WORKER_MAX.
OCCCCAD_IMPORT_CONCURRENCY=4

# Optional PostgreSQL integration resources (prepare the dedicated database first).
# OCCCCAD_TEST_DATABASE_URL=postgresql://user:password@host:5432/occccad_assembly_contract_test?sslmode=disable
# OCCCCAD_TEST_GEOMETRY_WORKER=/absolute/path/to/occccad/build/cmake/release/workers/geometry/occccad_geometry_worker
