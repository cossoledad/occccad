# occccad — External Service Addresses
#
# This repository does not manage infrastructure services.
# Configure PostgreSQL and the occcccad process here.
#
# Copy this file to .env and adjust for each environment:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL
# 固定使用数据库中的 occccad schema。
# ---------------------------------------------------------------------------
OCCCCAD_POSTGRES_HOST=127.0.0.1
OCCCCAD_POSTGRES_PORT=5432
OCCCCAD_POSTGRES_USER=occccad
OCCCCAD_POSTGRES_PASSWORD=occccad
OCCCCAD_POSTGRES_DB=occccad

# ---------------------------------------------------------------------------
# 账号与会话。首次启动必须设置管理员密码；创建完成后数据库中的哈希不会被覆盖。
# 生产环境必须启用 HTTPS 并设置 OCCCCAD_SECURE_COOKIES=true。
# ---------------------------------------------------------------------------
OCCCCAD_ADMIN_EMAIL=admin@occccad.local
OCCCCAD_ADMIN_DISPLAY_NAME=Administrator
OCCCCAD_ADMIN_PASSWORD=change-this-before-first-start
OCCCCAD_SESSION_DURATION=12h
OCCCCAD_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# 制品存储。相对路径以 API 服务的启动目录为基准。
# v0.0.7 只启用 LOCAL 后端；未来 S3 通过 ArtifactStore 接口接入，不需要 Redis。
# ---------------------------------------------------------------------------
OCCCCAD_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Service Ports
# ---------------------------------------------------------------------------
OCCCCAD_GATEWAY_PORT=8080
OCCCCAD_SERVER_LISTEN=0.0.0.0:8080
# 通常由前端开发服务器或生产反向代理把 /api 转发到 API，无需 CORS。
# 如果浏览器直接跨域访问 API，则按逗号分隔列出允许的前端 Origin。
OCCCCAD_ALLOWED_ORIGINS=
OCCCCAD_DOCUMENT_PORT=50051
OCCCCAD_PART_PORT=50052
OCCCCAD_PRODUCT_PORT=50053
OCCCCAD_SCHEDULER_PORT=50054

# ---------------------------------------------------------------------------
# Geometry Worker
# ---------------------------------------------------------------------------
OCCCCAD_GEOMETRY_WORKER_LISTEN=127.0.0.1:51001
OCCCCAD_GEOMETRY_WORKER_ADDRESS=127.0.0.1:51001

# ---------------------------------------------------------------------------
# Local application control plane
# invoke run.app only exposes APP_LISTEN. API and Geometry Router use stable
# internal addresses; managed worker instances start from FIRST_PORT.
# ---------------------------------------------------------------------------
OCCCCAD_APP_LISTEN=0.0.0.0:8080
OCCCCAD_CONTROL_LISTEN=127.0.0.1:19090
OCCCCAD_API_INTERNAL_LISTEN=127.0.0.1:18080
OCCCCAD_GEOMETRY_ROUTER_LISTEN=127.0.0.1:51001
OCCCCAD_GEOMETRY_WORKER_FIRST_PORT=51100
OCCCCAD_GEOMETRY_WORKER_MIN=1
OCCCCAD_GEOMETRY_WORKER_MAX=8
OCCCCAD_GEOMETRY_PER_WORKER=2
OCCCCAD_GEOMETRY_WORKER_IDLE=5m

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
OCCCCAD_BUILD_TYPE=Debug
OCCCCAD_ENABLE_ASAN=OFF
OCCCCAD_ENABLE_UBSAN=OFF

# ---------------------------------------------------------------------------
# Observability
# OTLP endpoint 留空时仍生成 Trace ID 并写入日志/Command，但不导出 Span。
# ---------------------------------------------------------------------------
OCCCCAD_LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
